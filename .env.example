# 이 파일을 .env 로 복사한 뒤 본인 값으로 채웁니다.
#   cp .env.example .env
# .env 는 .gitignore 에 들어 있어 깃에 올라가지 않습니다. 비밀은 여기에만 둡니다.

# ── AWS (「내 노트북은 서버가 아니다」 ④⑤) ──────────────────────
# bookstore-app 사용자의 액세스 키. 발급 화면을 벗어나면 다시 볼 수 없으니 그때 받아 둡니다.
AWS_ACCESS_KEY_ID=발급받은-액세스-키-ID
AWS_SECRET_ACCESS_KEY=발급받은-비밀-액세스-키
AWS_REGION=ap-northeast-2
S3_BUCKET=본인-버킷-이름

# ── DB (「DB는 전문가에게 맡긴다」 ④에서 RDS 로 바꿀 때 채웁니다) ──
# 로컬 compose 의 db 컨테이너를 쓰는 동안에는 비워 둬도 됩니다.
# application.yml 의 기본값(localhost:5433)이 적용됩니다.
# SPRING_DATASOURCE_URL=jdbc:postgresql://본인의-엔드포인트-주소:5432/db_project
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=본인의-마스터-암호
